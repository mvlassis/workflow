;;;; ========== Minibuffer and in-buffer completion ==========

(use-package corfu
  :ensure t
  :custom
  (corfu-auto t)
  (corfu-auto-delay 0.3)
  (corfu-auto-prefix 2)
  :hook ((prog-mode . corfu-mode)))

(use-package yasnippet
  :ensure t
  :hook (prog-mode . yas-minor-mode))

(use-package vertico
  :custom
  (vertico-cycle t)
  :config
  (setq read-file-name-completion-ignore-case t
        read-buffer-completion-ignore-case t
        completion-ignore-case t)
  :init
  (vertico-mode))

(use-package consult
  :after vertico
  :bind (("C-x b" . consult-buffer)
         ("M-s l" . consult-line))
  :config
  (consult-customize consult-theme :preview-key '(:debounce 0.5 any)))

(use-package marginalia
  :after vertico
  :custom
  (marginalia-annotators '(marginalia-annotators-heavy marginalia-annotators-light nil))
  :init
  (marginalia-mode))

(use-package orderless
  :custom
  (completion-styles '(orderless basic))
  (completion-category-overrides '((file (styles basic partial-completion)))))

;;;; ========== General programming tools ==========

;;; LSP client
(setq-default eglot-workspace-configuration
              '(:python (:analysis (:extraPaths ["lib"]))))

(use-package eglot
  :ensure nil
  :config
  (add-to-list 'eglot-server-programs
               '((python-mode python-ts-mode) . ("pyright-langserver" "--stdio")))
  (setq eglot-report-progress nil)
  (defun my-inhibit-eglot-messages (orig-fun &rest args)
    "Suppress all messages generated by `eglot--message'."
    (let ((inhibit-message t))
      (apply orig-fun args)))
  (advice-add 'eglot--message :around #'my-inhibit-eglot-messages)
  (add-hook 'eglot-managed-mode-hook (lambda () (eglot-inlay-hints-mode -1)))
  :hook
  (python-mode . eglot-ensure)
  (python-ts-mode . eglot-ensure)
  (rust-mode . eglot-ensure))

;;; Clickable breadcrumbs in the header line (project path + symbols)
(use-package breadcrumb
  :hook ((prog-mode text-mode conf-mode) . breadcrumb-local-mode))

;;; Checking and debugging
(use-package flycheck :defer t)
(use-package dap-mode :defer t)

;;; Git
(use-package magit
  :ensure t
  :config
  ;; `d P' in magit: diff a GitHub PR (needs the gh CLI).
  (transient-append-suffix 'magit-diff "p"
    '("P" "Diff pull request" my/magit-diff-pr))
  ;; `d m' in magit: diff main...HEAD.
  (transient-append-suffix 'magit-diff "P"
    '("m" "Diff main...HEAD" my/magit-diff-main)))

(defun my/magit-diff-main ()
  "Show changes on HEAD since it diverged from main."
  (interactive)
  (magit-diff-range "main...HEAD"))

(defvar my/magit-pr-remote "origin"
  "Remote that GitHub pull requests are fetched from.")

(defun my/magit-diff-pr (number)
  "Show a magit diff of GitHub PR NUMBER, like its \"Files changed\" tab.
Fetches the PR head into refs/pr/NUMBER and diffs it against the
merge-base with its base branch."
  (interactive
   (let* ((default-directory (magit-toplevel))
          (prs (with-temp-buffer
                 (unless (zerop (call-process
                                 "gh" nil t nil "pr" "list" "--limit" "100"
                                 "--json" "number,title,headRefName,author"))
                   (user-error "gh pr list failed: %s" (buffer-string)))
                 (goto-char (point-min))
                 (json-parse-buffer :object-type 'alist)))
          (cands (mapcar (lambda (pr)
                           (cons (format "#%-5d %s  [%s, @%s]"
                                         (alist-get 'number pr)
                                         (alist-get 'title pr)
                                         (alist-get 'headRefName pr)
                                         (alist-get 'login (alist-get 'author pr)))
                                 (alist-get 'number pr)))
                         prs))
          ;; Preselect the PR for the current branch, if any.
          (current (seq-find (lambda (pr)
                               (equal (alist-get 'headRefName pr)
                                      (magit-get-current-branch)))
                             prs))
          (choice (completing-read
                   "Pull request (or number): " cands nil nil nil nil
                   (and current (car (rassq (alist-get 'number current) cands))))))
     (list (or (cdr (assoc choice cands))
               (string-to-number (string-remove-prefix "#" choice))))))
  (let* ((default-directory (magit-toplevel))
         (base (string-trim
                (shell-command-to-string
                 (format "gh pr view %d --json baseRefName -q .baseRefName" number))))
         (remote my/magit-pr-remote)
         (pr-ref (format "refs/pr/%d" number)))
    (when (string-empty-p base)
      (user-error "Could not determine base branch of PR #%d" number))
    (message "Fetching PR #%d and %s/%s..." number remote base)
    (unless (zerop (magit-call-git
                    "fetch" remote
                    (format "+refs/pull/%d/head:%s" number pr-ref)
                    (format "+refs/heads/%s:refs/remotes/%s/%s" base remote base)))
      (user-error "git fetch failed, see `magit-process' buffer ($)"))
    (magit-diff-range (format "%s/%s...%s" remote base pr-ref))))

;;; Projects
;; Useful commands (M-x NAME, or key under the `C-c p' prefix):
;;   projectile-switch-project   C-c p p   pick a project
;;   projectile-find-file        C-c p f   find file in project
;;   projectile-ripgrep          C-c p s r search project with rg
;;   projectile-grep             C-c p s g search project with grep
;;   projectile-vc               C-c p v   magit-status for project
;;   projectile-discover-projects-in-search-path  scan search path
(use-package projectile
  :init (projectile-mode 1)
  :bind-keymap ("C-c p" . projectile-command-map)
  :config
  ;; After `projectile-switch-project', open magit-status.
  (setq projectile-switch-project-action #'projectile-vc))

;;; Visual helpers
;; Shows colors of hex codes
(use-package rainbow-mode
  ;; Only in modes where color literals are expected; in prog-mode it
  ;; mistakes things like issue refs (#591) for hex colors.
  :hook ((css-mode css-ts-mode scss-mode web-mode html-mode mhtml-mode
          emacs-lisp-mode conf-mode) . rainbow-mode))

(use-package rainbow-delimiters
  :hook (prog-mode . rainbow-delimiters-mode))

;;; Project tree, terminal, notebooks
(use-package treemacs
  :defer t
  :init
  (with-eval-after-load 'winum
    (define-key winum-keymap (kbd "M-0") #'treemacs-select-window))
  :bind
  ("<f1>" . treemacs)
  :config
  ;; Single left click toggles directories (and opens files)
  (define-key treemacs-mode-map [mouse-1] #'treemacs-single-click-expand-action))

;; Emacs front-end that `projectile-ripgrep' needs (also needs the `rg' binary)
(use-package ripgrep
  :defer t)

(use-package treemacs-projectile
  :after (treemacs projectile))

(use-package vterm
  :defer t
  :bind (:map vterm-mode-map ("C-y" . vterm-yank))
  :config
  (setq vterm-max-scrollback 10000)
  :hook (vterm-mode . (lambda () (display-line-numbers-mode 0))))

;; (use-package ein) ; Jupyter notebook in Emacs
(use-package code-cells)

;;;; ========== Formatting ==========

(defun my/apheleia-python-formatter ()
  "Choose Black or Ruff using the nearest pyproject.toml.
Black wins when both are configured; use `.dir-locals.el' to override."
  (or (when-let* ((root (locate-dominating-file default-directory "pyproject.toml")))
        (with-temp-buffer
          (insert-file-contents (expand-file-name "pyproject.toml" root))
          (cond
           ((progn
              (goto-char (point-min))
              (re-search-forward "^\\s-*\\[tool\\.black\\]" nil t))
            'black)
           ((progn
              (goto-char (point-min))
              (re-search-forward "^\\s-*\\[tool\\.ruff\\(?:\\..*\\)?\\]" nil t))
            'ruff))))
      'ruff))

(defun my/apheleia-python-setup ()
  "Select the project's Python formatter and format on save."
  (setq-local apheleia-formatter (my/apheleia-python-formatter))
  (apheleia-mode))

(use-package apheleia
  :hook ((js-mode . apheleia-mode)
         (python-mode . my/apheleia-python-setup)
         (python-ts-mode . my/apheleia-python-setup))
  :config
  ;; Use real npx so Prettier can be downloaded and cached when needed.
  (setf (alist-get 'prettier-javascript apheleia-formatters)
        '("npx" "--yes" "prettier" "--stdin-filepath" filepath
          "--parser=babel-flow"
          "--tab-width=2"))

  ;; Resolve Python formatters from the project environment, then globally.
  (setf (alist-get 'black apheleia-formatters)
        `((or (pet-executable-find "black" t) "black")
          ,@(cdr (alist-get 'black apheleia-formatters)))
        (alist-get 'ruff apheleia-formatters)
        `((or (pet-executable-find "ruff" t) "ruff")
          ,@(cdr (alist-get 'ruff apheleia-formatters)))))

;;;; ========== Language-specific configuration ==========

;;; C / CUDA
(setq c-default-style "linux"
      c-basic-offset 4)
(add-to-list 'auto-mode-alist '("\\.cu$" . c-mode))

;;; Shell
(add-to-list 'auto-mode-alist '("bashrc\\'" . sh-mode))
(add-to-list 'auto-mode-alist '("zshrc\\'" . sh-mode))
(add-to-list 'auto-mode-alist '("config\\'" . sh-mode))

;;; Python
(setq python-indent-guess-indent-offset-verbose nil)

;; Use tree-sitter for Python; auto-install the grammar if missing
(setq treesit-language-source-alist
      '((python "https://github.com/tree-sitter/tree-sitter-python")))

(when (and (not (treesit-language-available-p 'python))
           (executable-find "git")
           (or (executable-find "cc") (executable-find "gcc")))
  (treesit-install-language-grammar 'python))

(when (treesit-language-available-p 'python)
  (add-to-list 'major-mode-remap-alist '(python-mode . python-ts-mode)))
(setq treesit-font-lock-level 4)

(use-package poetry
  :config
  (setq poetry-tracking-strategy 'project))

(use-package pet
  :init
  ;; Depth -10 so this runs before `eglot-ensure'
  (dolist (hook '(python-mode-hook python-ts-mode-hook))
    (add-hook hook
              (lambda ()
                (setq-local python-shell-interpreter (pet-executable-find "python"))
                (pet-eglot-setup))
              -10)))

;;; Web
(use-package js
  :ensure nil
  :defer t
  :custom
  (js-indent-level 2)
  (js-switch-indent-offset 2)
  (sgml-basic-offset 2)
  :hook ((js-mode . (lambda () (setq-local tab-width 2)))
         (js-mode . subword-mode)
         (js-mode . electric-pair-mode)
         (js-mode . eglot-ensure)
         (js-mode . completion-preview-mode)))

(add-to-list 'auto-mode-alist '("\\.ts\\'" . js-mode))
(setq css-indent-offset 2)

;;; Go, Rust, Lua
(use-package go-mode)
(use-package rust-mode :defer t)
(use-package lua-mode)

;;; Config / infra file formats
(use-package yaml :defer t)
(use-package yaml-mode
  :mode (("\\.yml\\'" . yaml-mode)
         ("\\.yaml\\.j2\\'" . yaml-mode)))

;; Clean trailing whitespace on save in YAML (buffer-local)
(add-hook 'yaml-mode-hook
          (lambda ()
            (add-hook 'before-save-hook 'delete-trailing-whitespace nil t)))

(use-package dockerfile-mode)
(use-package terraform-mode)
(use-package just-mode)
(use-package ini-mode
  :mode ("\\.ini\\'" . ini-mode))

;;; Embedded
(use-package arduino-mode
  :mode ("\\.ino\\'" . arduino-mode))

(provide 'init-dev)
