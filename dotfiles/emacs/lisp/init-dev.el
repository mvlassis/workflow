;;; init-dev.el --- Completion, programming tools and languages -*- lexical-binding: t; -*-

;;;; ========== Minibuffer and in-buffer completion ==========

(use-package corfu
  :ensure t
  :hook ((prog-mode . corfu-mode)))

(use-package vertico
  :custom
  (vertico-cycle t)
  :config
  (setq read-file-name-completion-ignore-case t
        read-buffer-completion-ignore-case t
        completion-ignore-case t)
  :init
  (vertico-mode))

(use-package consult
  :after vertico
  :bind (("C-x b" . consult-buffer)
         ("M-s l" . consult-line))
  :config
  (consult-customize consult-theme :preview-key '(:debounce 0.5 any)))

(use-package marginalia
  :after vertico
  :custom
  (marginalia-annotators '(marginalia-annotators-heavy marginalia-annotators-light nil))
  :init
  (marginalia-mode))

(use-package orderless
  :custom
  (completion-styles '(orderless basic))
  (completion-category-overrides '((file (styles basic partial-completion)))))

(use-package company
  :config
  (global-company-mode)
  (setq company-minimum-prefix-length 5
        company-idle-delay 1))  ; Delay to display suggestions

;;;; ========== General programming tools ==========

;;; LSP client
(setq-default eglot-workspace-configuration
              '(:python (:analysis (:extraPaths ["lib"]))))

(use-package eglot
  :ensure nil
  :config
  (add-to-list 'eglot-server-programs
               '(python-mode . ("pyright-langserver" "--stdio")))
  (setq eglot-report-progress nil)
  (defun my-inhibit-eglot-messages (orig-fun &rest args)
    "Suppress all messages generated by `eglot--message'."
    (let ((inhibit-message t))
      (apply orig-fun args)))
  (advice-add 'eglot--message :around #'my-inhibit-eglot-messages)
  (add-hook 'eglot-managed-mode-hook (lambda () (eglot-inlay-hints-mode -1)))
  :hook
  (python-mode . eglot-ensure)
  (rust-mode . eglot-ensure))

;;; Checking and debugging
(use-package flycheck :defer t)
(use-package dap-mode :defer t)

;;; Visual helpers
;; Shows colors of hex codes
(use-package rainbow-mode
  :hook (prog-mode . rainbow-mode))

(use-package rainbow-delimiters
  :hook (prog-mode . rainbow-delimiters-mode))

;;; Project tree, terminal, notebooks
(use-package treemacs
  :defer t
  :init
  (with-eval-after-load 'winum
    (define-key winum-keymap (kbd "M-0") #'treemacs-select-window))
  :bind
  ("<f1>" . treemacs))

(use-package vterm
  :defer t
  :bind (:map vterm-mode-map ("C-y" . vterm-yank))
  :config
  (setq vterm-max-scrollback 10000)
  :hook (vterm-mode . (lambda () (display-line-numbers-mode 0))))

;; (use-package ein) ; Jupyter notebook in Emacs
(use-package code-cells)

;;;; ========== Language-specific configuration ==========

;;; C / CUDA
(setq c-default-style "linux"
      c-basic-offset 4)
(add-to-list 'auto-mode-alist '("\\.cu$" . c-mode))

;;; Shell
(add-to-list 'auto-mode-alist '("bashrc\\'" . sh-mode))
(add-to-list 'auto-mode-alist '("zshrc\\'" . sh-mode))
(add-to-list 'auto-mode-alist '("config\\'" . sh-mode))

;;; Python
(setq python-indent-guess-indent-offset-verbose nil)

(use-package poetry
  :config
  (setq poetry-tracking-strategy 'project))

(use-package pet
  :init
  ;; Depth -10 so this runs before `eglot-ensure'
  (add-hook 'python-mode-hook
            (lambda ()
              (setq-local python-shell-interpreter (pet-executable-find "python"))
              (pet-eglot-setup))
            -10))

;;; Web
(use-package js
  :ensure nil
  :defer t
  :custom
  (js-indent-level 2)
  :hook ((js-mode . subword-mode)
         (js-mode . electric-pair-mode)
         (js-mode . eglot-ensure)
         (js-mode . completion-preview-mode)))

(add-to-list 'auto-mode-alist '("\\.ts\\'" . js-mode))
(setq css-indent-offset 2)

;;; Go, Rust, Lua
(use-package go-mode)
(use-package rust-mode :defer t)
(use-package lua-mode)

;;; Config / infra file formats
(use-package yaml :defer t)
(use-package yaml-mode
  :mode (("\\.yml\\'" . yaml-mode)
         ("\\.yaml\\.j2\\'" . yaml-mode)))

;; Clean trailing whitespace on save in YAML (buffer-local)
(add-hook 'yaml-mode-hook
          (lambda ()
            (add-hook 'before-save-hook 'delete-trailing-whitespace nil t)))

(use-package dockerfile-mode)
(use-package terraform-mode)
(use-package just-mode)
(use-package ini-mode
  :mode ("\\.ini\\'" . ini-mode))

;;; Embedded
(use-package arduino-mode
  :mode ("\\.ino\\'" . arduino-mode))

(provide 'init-dev)
;;; init-dev.el ends here
